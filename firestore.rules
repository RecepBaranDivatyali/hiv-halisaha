rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── YARDIMCI FONKSİYONLAR ───
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'baranimoley@gmail.com',
          'barandivatyali@gmail.com',
          'admin@hivhalisaha.com',
          'yonetim@hivhalisaha.com'
        ] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ─── KULLANICILAR (USERS) ───
    match /users/{userId} {
      // Tüm oturum açmış kullanıcılar profil bilgilerini görebilir
      allow read: if isAuthenticated();
      // Kullanıcı yalnızca kendi profilini silebilir
      allow create, delete: if isOwner(userId) || isAdmin();
      // Profil güncelleme: Profil sahibi, Admin veya maç sonucu/oylama istatistik artırımı (stats, rating)
      allow update: if isOwner(userId) || isAdmin() || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'rating', 'updatedAt'])
      );
    }

    // ─── MAÇLAR (MATCHES) ───
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      // Oturum açmış kullanıcılar maç ilanı oluşturabilir
      allow create: if isAuthenticated();
      // Maç güncelleme: Organizatör, Admin veya slot/katılımcı/yedek değişiklikleri
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.organizerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'slots', 
          'joinedPlayersCount', 
          'reserves', 
          'benchA', 
          'benchB', 
          'captainAId', 
          'captainBId', 
          'captainBName', 
          'score', 
          'formaGoluTeam', 
          'status', 
          'updatedAt'
        ])
      );
      // Maç silme: Yalnızca organizatör veya Admin
      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.organizerId == request.auth.uid
      );
    }

    // ─── KULÜPLER (CLUBS) ───
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() || isAdmin();
      // Kulüp güncelleme: Admin, kulüp lideri/kaptanı veya üye katılım/ayrılma/devretme/istek güncellemesi
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.leaderId == request.auth.uid ||
        resource.data.captainId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'membersCount', 'members', 'updatedAt', 'captainId', 'captainName', 'joinPolicy', 'joinRequests', 'inviteCode'
        ])
      );
      // Kulüp silme: Admin, kulüp lideri / kaptanı veya kulüpte tek kalan üye (sıradan üyeler silemez!)
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.leaderId == request.auth.uid ||
        resource.data.captainId == request.auth.uid ||
        (resource.data.members != null && request.auth.uid in resource.data.members && (resource.data.membersCount == 1 || resource.data.members.size() == 1))
      );
    }

    // ─── HALISAHA / TESİSLER (PITCHES) ───
    match /pitches/{pitchId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ─── TESİS ÖNERİLERİ (PITCH PROPOSALS) ───
    match /pitch_proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ─── TESİS YORUM & PUANLARI (PITCH REVIEWS) ───
    match /pitch_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Kullanıcı yalnızca kendi tesis yorumunu güncelleyebilir veya silebilir
      allow update, delete: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
    }

    // ─── MAÇ VE OYUNCU PUANLAMALARI (RATINGS) ───
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── KULÜP MEYDAN OKUMALARI (CLUB CHALLENGES) ───
    match /club_challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.senderId == request.auth.uid ||
        resource.data.toCaptainId == request.auth.uid ||
        resource.data.targetCaptainId == request.auth.uid ||
        resource.data.status == 'pending'
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
    }

    // ─── SOHBETLER & MESAJLAŞMA (CONVERSATIONS) ───
    match /conversations/{conversationId} {
      // Yalnızca sohbetin katılımcıları ve adminler okuyabilir
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.participants != null && request.auth.uid in request.resource.data.participants
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.participants != null && request.auth.uid in resource.data.participants)
      );
      
      // Alt koleksiyon: Mesajlar
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isAdmin() || 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if isAuthenticated() && (
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow update, delete: if isAdmin() || (
          isAuthenticated() && resource.data.senderId == request.auth.uid
        );
      }
    }

    // ─── SİSTEM AYARLARI (SETTINGS) ───
    match /settings/{settingId} {
      // Bakım modu ve platform ayarlarını tüm istemciler okuyabilir
      allow read: if true;
      // Ayarları yalnızca Admin değiştirebilir
      allow write: if isAdmin();
    }

    // ─── ADMİNLER LİSTESİ (ADMINS) ───
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
