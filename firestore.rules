rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── YARDIMCI FONKSİYONLAR ───
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true && request.auth.token.email in [
          'baranimoley@gmail.com',
          'barandivatyali@gmail.com'
        ]) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ─── KULLANICILAR (USERS) ───
    match /users/{userId} {
      // Tüm oturum açmış kullanıcılar profil bilgilerini görebilir
      allow read: if isAuthenticated();
      // Hesap oluşturma: Kullanıcı kendi profilini oluşturabilir ancak yetki yükseltemez (role == 'user' ve isBanned == false olmalı)
      allow create: if (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
        (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false)
      ) || isAdmin();
      // Kullanıcı yalnızca kendi profilini silebilir veya Admin silebilir (GDPR / Store uyumluluğu)
      allow delete: if isOwner(userId) || isAdmin();
      // Profil güncelleme:
      // 1. Profil sahibi 'role' ve 'isBanned' alanlarını DEĞİŞTİREMEZ (Zero-Trust yetki yükseltme engeli)
      // 2. Diğer kullanıcılar yalnızca maç sonucu / istatistik / kulüp katılım alanlarını güncelleyebilir
      // 3. Admin her alanı güncelleyebilir
      allow update: if (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned'])
      ) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stats', 'rating', 'clubId', 'clubName', 'clubLogo', 'updatedAt'
        ])
      ) || isAdmin();

      // Alt koleksiyon: Kullanıcı Bildirimleri
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated();
      }
    }

    // ─── BİLDİRİMLER KÖK KOLEKSİYONU (NOTIFICATIONS) ───
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
    }

    // ─── MAÇLAR (MATCHES) ───
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      // Oturum açmış kullanıcılar yalnızca kendi adına (veya meydan okuma kabulünde B kaptanı olarak) maç ilanı oluşturabilir
      allow create: if isAuthenticated() && (
        request.resource.data.organizerId == request.auth.uid ||
        request.resource.data.captainBId == request.auth.uid ||
        isAdmin()
      );
      // Maç güncelleme: Organizatör ve A Kaptanı tam yetkili; B Kaptanı kendi takım/skor alanlarını; sıradan oyuncu slot/yedek/ödeme alanlarını güncelleyebilir
      allow update: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        resource.data.captainAId == request.auth.uid ||
        (
          resource.data.captainBId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'slots',
            'joinedPlayersCount',
            'reserves',
            'benchB',
            'teamBFormation',
            'teamBHidden',
            'teamBJoinTerms',
            'score',
            'scoreTeamA',
            'scoreTeamB',
            'status',
            'formaGoluTeam',
            'updatedAt',
            'payments',
            'paymentStatus'
          ])
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'slots', 
          'joinedPlayersCount', 
          'reserves', 
          'benchA', 
          'benchB', 
          'updatedAt',
          'payments',
          'paymentStatus'
        ]) ||
        isAdmin()
      );
      // Maç silme: Yalnızca organizatör veya Admin
      allow delete: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── KULÜPLER (CLUBS) ───
    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() || isAdmin();
      // Kulüp güncelleme: Kulüp lideri/kaptanı, üye katılım/ayrılma/istek güncellemesi veya Admin
      allow update: if isAuthenticated() && (
        resource.data.leaderId == request.auth.uid ||
        resource.data.captainId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'membersCount', 'members', 'updatedAt', 'joinRequests'
        ]) ||
        isAdmin()
      );
      // Kulüp silme: Yalnızca kulüp lideri, kaptanı veya Admin
      allow delete: if isAuthenticated() && (
        resource.data.leaderId == request.auth.uid ||
        resource.data.captainId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── HALISAHA / TESİSLER (PITCHES) ───
    match /pitches/{pitchId} {
      // Halısaha tesis kataloğunu tüm kullanıcılar (misafirler dahil) görüntüleyebilir
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── TESİS ÖNERİLERİ (PITCH PROPOSALS) ───
    match /pitch_proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ─── TESİS YORUM & PUANLARI (PITCH REVIEWS) ───
    match /pitch_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Kullanıcı yalnızca kendi tesis yorumunu güncelleyebilir veya silebilir
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── MAÇ VE OYUNCU PUANLAMALARI (RATINGS) ───
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── KULÜP MEYDAN OKUMALARI (CLUB CHALLENGES) ───
    match /club_challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.toCaptainId == request.auth.uid ||
        resource.data.targetCaptainId == request.auth.uid ||
        (
          resource.data.toClubId != null &&
          exists(/databases/$(database)/documents/clubs/$(resource.data.toClubId)) &&
          get(/databases/$(database)/documents/clubs/$(resource.data.toClubId)).data.captainId == request.auth.uid
        ) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── SOHBETLER & MESAJLAŞMA (CONVERSATIONS) ───
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        conversationId == 'general_chat' ||
        conversationId.matches('^(match_|club_).*') ||
        conversationId.matches('.*' + request.auth.uid + '.*') ||
        (resource != null && resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        conversationId == 'general_chat' ||
        conversationId.matches('^(match_|club_).*') ||
        conversationId.matches('.*' + request.auth.uid + '.*') ||
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        conversationId == 'general_chat' ||
        conversationId.matches('^(match_|club_).*') ||
        (
          resource != null &&
          resource.data.participants != null &&
          request.auth.uid in resource.data.participants &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants']) || request.resource.data.participants == resource.data.participants)
        ) ||
        isAdmin()
      );
      
      // Alt koleksiyon: Mesajlar
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          conversationId == 'general_chat' ||
          conversationId.matches('^(match_|club_).*') ||
          conversationId.matches('.*' + request.auth.uid + '.*') ||
          resource.data.senderId == request.auth.uid ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          (
            conversationId == 'general_chat' &&
            request.resource.data.senderId == request.auth.uid
          ) ||
          (
            conversationId.matches('^(match_|club_).*') &&
            (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'system')
          ) ||
          (
            request.resource.data.senderId == request.auth.uid &&
            (
              (exists(/databases/$(database)/documents/conversations/$(conversationId)) && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) ||
              (existsAfter(/databases/$(database)/documents/conversations/$(conversationId)) && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
            )
          ) ||
          isAdmin()
        );
        allow update, delete: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ─── SİSTEM AYARLARI (SETTINGS) ───
    match /settings/{settingId} {
      // Bakım modu ve platform ayarlarını tüm istemciler okuyabilir
      allow read: if true;
      // Ayarları yalnızca Admin değiştirebilir
      allow write: if isAdmin();
    }

    // ─── HESAP SİLME TALEPLERİ (DELETION REQUESTS) ───
    match /deletion_requests/{reqId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'reason', 'details', 'refCode', 'status', 'createdAt']) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.email.size() <= 200;
      allow read, update, delete: if isAdmin();
    }

    // ─── ADMİNLER LİSTESİ (ADMINS) ───
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
